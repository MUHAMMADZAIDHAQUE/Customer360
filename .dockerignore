# ==============================================================================
# Customer360 - Docker Build Context Ignore Rules
# ==============================================================================

# Git & IDE
.git
.gitignore
.DS_Store
.vscode
.idea

# Environment & Secrets (Never bake secrets into Docker images)
.env
.env.local
.env.*.local

# Virtual Environment & Python Caches
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.log

# Node.js & Frontend build caches (Frontend Dockerfile uses multi-stage npm ci)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# dbt Logs & Local Targets
dbt/logs/
dbt/target/
dbt/dbt_packages/
