# ==============================================================================
# Customer360 - Production Environment Configuration (.env.production)
# AI-Powered Customer Intelligence & Retention Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Service Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False
API_WORKERS=4

# Comma-separated list of allowed HTTPS origins (NO WILDCARD '*' IN PRODUCTION)
CORS_ORIGINS=https://customer360.company.com,https://app.customer360.company.com

# ------------------------------------------------------------------------------
# 3. Frontend Web Client Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=https://api.customer360.company.com

# ------------------------------------------------------------------------------
# 4. Managed PostgreSQL Production Connection (e.g. AWS RDS / Cloud SQL)
# DO NOT EXPOSE TO THE PUBLIC INTERNET - LOCATE IN PRIVATE VPC SUBNET
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres-prod.internal.vpc
POSTGRES_PORT=5432
POSTGRES_DB=customer360_prod
POSTGRES_USER=customer360_app_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_SECRET_IN_VAULT

# SQLAlchemy Connection String with SSL & Pooling
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=require

# Connection Pool Limits
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 5. Embedded Analytics & Storage
# ------------------------------------------------------------------------------
DUCKDB_PATH=/app/data/processed/customer360.duckdb

# ------------------------------------------------------------------------------
# 6. AI Analyst & Natural Language Intelligence (Phase 4 / LLM Integration)
# Inject from AWS Secrets Manager / GCP Secret Manager / Vault
# ------------------------------------------------------------------------------
OPENAI_API_KEY=REPLACE_WITH_PRODUCTION_OPENAI_API_KEY
MODEL_NAME=gpt-4o
ANALYST_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 7. Sentry / Error Monitoring (Optional Cloud Telemetry)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2
